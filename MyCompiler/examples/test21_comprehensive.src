// test21_comprehensive: 综合测试 (函数+循环+条件+全局变量)
int count;

int isEven(int n) {
    int r = 0;
    if (n % 2 == 0)
        r = 1;
    return r;
}

void countUp() {
    count = count + 1;
}

int sumTo(int n) {
    int s = 0;
    int i = 1;
    while (i <= n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}

int main() {
    count = 0;
    int i = 1;
    while (i <= 5) {
        if (isEven(i)) {
            countUp();
        }
        i = i + 1;
    }
    int s = sumTo(4);
    return count * 10 + s;
}
// 期望: 2个偶数(2,4) → count=2, sumTo(4)=10 → 20+10=30
