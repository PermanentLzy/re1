// test26_mutual_rec: 互递归函数
int isOdd(int n);

int isEven(int n) {
    if (n == 0)
        return 1;
    return isOdd(n - 1);
}

int isOdd(int n) {
    if (n == 0)
        return 0;
    return isEven(n - 1);
}

int main() {
    int r = 0;
    if (isEven(4)) r = r + 1;
    if (isEven(5)) r = r + 2;
    if (isOdd(3))  r = r + 4;
    if (isOdd(4))  r = r + 8;
    return r;
}
// 期望: isEven(4)=1, isEven(5)=0, isOdd(3)=1, isOdd(4)=0 → 1+0+4+0 = 5
