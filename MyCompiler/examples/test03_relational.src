// test03_relational: 关系运算符
int main() {
    int a = 10;
    int b = 20;
    int c = 10;
    int r = 0;
    if (a < b)  r = r + 1;
    if (a > b)  r = r + 2;
    if (a <= c) r = r + 4;
    if (b >= a) r = r + 8;
    if (a == c) r = r + 16;
    if (a != b) r = r + 32;
    return r;
}
// 期望: 1+0+4+8+16+32 = 61
