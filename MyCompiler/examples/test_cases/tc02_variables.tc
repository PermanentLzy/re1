// tc02_variables.tc
// 测试: 变量声明、赋值、作用域嵌套
int main() {
    int x = 10;
    int y = x + 5;          // 15
    x = y - 3;              // 12
    {
        int x = 100;        // 内层屏蔽外层
        int z = x + y;      // 100 + 15 = 115
        y = z;              // y = 115 (外层y被修改)
    }
    // x 回到外层值 12, y 已被改成 115
    return x + y;           // 12 + 115 = 127
}
