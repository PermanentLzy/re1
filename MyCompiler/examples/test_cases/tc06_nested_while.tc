// tc06_nested_while.tc
// 测试: 嵌套 while + break(只跳出内层)
int main() {
    int i = 0;
    int j = 0;
    int count = 0;
    while (i < 3) {
        j = 0;
        while (j < 5) {
            if (j == 2)
                break;      // 只跳出内层
            count = count + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    // 内层每次加2次(0,1) × 外层3次 = 6
    return count;
}
