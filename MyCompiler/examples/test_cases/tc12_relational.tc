// tc12_relational.tc
// 测试: 全部关系运算符 < > <= >= == !=
int main() {
    int t = 1;  // true
    int f = 0;  // false
    int r = 0;
    if (3 < 5)  r = r + 1;     // 1
    if (5 > 3)  r = r + 2;     // 3
    if (3 <= 3) r = r + 4;     // 7
    if (5 >= 5) r = r + 8;     // 15
    if (3 == 3) r = r + 16;    // 31
    if (3 != 5) r = r + 32;    // 63
    return r;
}
